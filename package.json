{
  "name": "@aarivbuildz/urlguard",
  "version": "0.1.0",
  "description": "Zero-dependency RFC-aware SSRF, private-IP, DNS-rebinding and redirect-chain guard for Node.js and edge runtimes",
  "type": "module",
  "license": "MIT",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./runtime/node": {
      "types": "./types/runtime-node.d.ts",
      "import": "./src/runtime-node.mjs",
      "require": "./cjs/runtime-node.cjs"
    }
  },
  "files": [
    "src/",
    "cjs/",
    "types/",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOOD_FIRST_ISSUES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build-cjs.mjs",
    "test": "node scripts/run-tests.mjs tests/*.test.mjs",
    "test:all": "node scripts/build-cjs.mjs && node scripts/run-tests.mjs tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "ssrf",
    "url",
    "security",
    "ipv6",
    "dns-rebinding",
    "redirect",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/urlguard.git"
  },
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/urlguard/issues"
  },
  "homepage": "https://github.com/draarivpatel-ui/urlguard#readme",
  "publishConfig": {
    "access": "public"
  }
}
